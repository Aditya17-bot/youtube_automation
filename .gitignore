.venv/
__pycache__/
*.pyc

# Generated media and intermediate render artefacts
out/
# Diffusion output is a regenerable cache keyed by prompt hash, not source
assets/generated/
# Source films: hundreds of MB each, re-fetchable from the licence bank in
# channels/footage_*.yaml. The shot index in state/ is what must not be lost.
assets/footage/
assets/music/*.wav
assets/music/*.mp3

# OAuth client secrets and cached refresh tokens - never commit
secrets/

# Per-channel topic history
state/
